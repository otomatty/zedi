# Copy to `.env.worker.dev` (gitignored) and fill values, then:
#   bun run worker:secrets:put -- --env dev
#
# R2 binding (STORAGE_BUCKET) and vars (ENVIRONMENT / RUNTIME) are in
# wrangler.jsonc — not secrets.
# These STORAGE_* values are for S3-compatible presigned URLs only (#1089).

STORAGE_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=zedi-storage-dev

# Auth — required at Worker module load (#1091 A-2). BETTER_AUTH_SECRET must
# equal the API/MCP shared value.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
CORS_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Required at module load even before #1090 (auth's drizzle adapter constructs
# a lazy pg.Pool). Use a placeholder until D1 lands — no connection is made
# until a DB-backed route runs (those return masked 5xx on the Worker).
DATABASE_URL=

# Sentry (Workers runtime, @sentry/cloudflare withSentry — #1091 FR-3).
# Leave empty to no-op.
SENTRY_DSN_API=

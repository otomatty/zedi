{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zedi-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "r2_buckets": [
    {
      "binding": "STORAGE_BUCKET",
      "bucket_name": "zedi-storage-prod",
    },
  ],
  // KV Durable Objects (#1093): レート制限カウンタ・ワンタイムコード・MCP deny-list。
  // migrations はトップレベルのみ（wrangler が deploy 対象の env に適用する）。
  "durable_objects": {
    "bindings": [
      {
        "name": "KV_DO",
        "class_name": "KvDurableObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KvDurableObject"],
    },
  ],
  "env": {
    "dev": {
      "name": "zedi-api-dev",
      "r2_buckets": [
        {
          "binding": "STORAGE_BUCKET",
          "bucket_name": "zedi-storage-dev",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "KV_DO",
            "class_name": "KvDurableObject",
          },
        ],
      },
      "vars": {
        "ENVIRONMENT": "development",
      },
    },
    "production": {
      "name": "zedi-api",
      "r2_buckets": [
        {
          "binding": "STORAGE_BUCKET",
          "bucket_name": "zedi-storage-prod",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "KV_DO",
            "class_name": "KvDurableObject",
          },
        ],
      },
      "vars": {
        "ENVIRONMENT": "production",
      },
    },
  },
}

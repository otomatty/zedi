    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-typography": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/html": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/y-tiptap": "^3.0.10",
    "@xyflow/react": "^12.12.0",
    "@zedi/shared": "workspace:*",
    "@zedi/ui": "workspace:*",
    "baseline-browser-mapping": "^2.11.34",
    "better-auth": "^1.7.14",
    "caniuse-lite": "^1.0.30001819",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",

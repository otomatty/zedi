{
  "name": "zedi",
  "version": "0.24.0",
  "description": "Zero-Friction Knowledge Network - AIネイティブなナレッジアプリ",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "admin"
  ],
  "author": "Zedi Team",
  "license": "BSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/otomatty/zedi.git"
  },
  "keywords": [
    "knowledge-management",
    "note-taking",
    "wiki",
    "ai",
    "react",
    "typescript"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "dev:admin": "cd admin && npm run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check-pairs": "node scripts/check-doc-pairs.mjs",
    "init": "node scripts/init.mjs",
    "setup:agent-mirrors": "node scripts/setup-agent-mirrors.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run && vitest run --config packages/shared/vitest.config.ts && vitest run --config packages/ui/vitest.config.ts && vitest run --config admin/vitest.config.ts",
    "test:coverage": "node scripts/run-workspace-coverage.mjs",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:mutation": "stryker run",
    "test:mutation:dry": "stryker run --dryRunOnly",
    "test:mutation:changed": "node scripts/stryker-mutate-changed.mjs",
    "test:mutation:changed:list": "node scripts/stryker-mutate-changed.mjs --list",
    "mutation:report:summary": "node scripts/stryker-mutation-report-summarize.mjs",
    "test:mutation:changed:summary": "node scripts/stryker-mutate-changed.mjs && node scripts/stryker-mutation-report-summarize.mjs",
    "knip": "knip",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,jsx,cjs,mjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.0.0"
  },
  "overrides": {
    "esbuild": ">=0.25.0",
    "lodash-es": ">=4.18.0",
    "dompurify": ">=3.4.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@dagrejs/dagre": "^3.1.3",
    "@google/genai": "^2.31.0",
    "@google/generative-ai": "^0.24.1",

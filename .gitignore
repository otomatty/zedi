# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files (sensitive data)
.env.development
.env.production
.env
server/.dev.vars
# Worker secret bulk-upload sources (examples are committed)
server/api/.env.worker.dev
server/api/.env.worker.production
server/mcp/.env.worker.dev
server/mcp/.env.worker.production

# Server build artifacts
server/api/dist/
server/hocuspocus/dist/

# Windows reserved device names (can be created accidentally)
nul

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test coverage (Vitest, etc.)
coverage/
*.lcov
.stryker-tmp/
reports/mutation/

# Playwright
playwright-report/
test-results/

# Drizzle: migration files in server/api/drizzle/ are committed so CI and other envs can run migrate

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example

# TypeScript build info
*.tsbuildinfo

# Claude Code — local only (settings, worktrees, mirrors). Canonical: .agents/
# ローカル専用。正本は .agents/ — ミラーは bun run init / setup:agent-mirrors
.claude/

# Cursor agent mirrors (local junctions/symlinks — not duplicated content)
.cursor/skills/
.cursor/agents/

# Local-only notes (not tracked). See AGENTS.md.
/docs/
/journal/

# AI-DLC — per-user cursors and machine-local runtime (aidlc-workflows v2)
# Rule: commit shared work (method, state, audit shards, artifacts); ignore cursors/runtime.
aidlc/active-space
aidlc/spaces/*/intents/active-intent
aidlc/.aidlc-clone-id
aidlc/.aidlc-sessions/
aidlc/spaces/*/intents/*/runtime-graph.json
aidlc/spaces/*/intents/*/.aidlc-*

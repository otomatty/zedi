{
  "name": "zedi-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zedi rebuilt on a single Cloudflare Worker: hono/jsx/dom client, Hono API, D1 and Durable Objects",
  "scripts": {
    "dev:client": "vite",
    "dev:worker": "wrangler dev -c wrangler.jsonc -c wrangler.test-idp.jsonc --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run && vitest run -c vitest.config.worker.ts",
    "bundle:report": "node scripts/bundleReport.mjs",
    "measure": "node scripts/measure.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:unit": "vitest run",
    "test:worker": "vitest run -c vitest.config.worker.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@better-auth/utils": "^0.5.1",
    "@floating-ui/dom": "^1.8.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/query-core": "^5.106.1",
    "@tanstack/virtual-core": "^3.19.11",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-collaboration": "^3.33.0",
    "@tiptap/extension-collaboration-caret": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@tiptap/suggestion": "^3.33.0",
    "@tiptap/y-tiptap": "3.0.11",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "marked": "^18.1.3",
    "partyserver": "^0.5.10",
    "uqr": "^0.1.3",
    "y-indexeddb": "^9.0.12",
    "y-partyserver": "^2.2.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "lib0": "^0.2.117",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "5.1.0",
    "wrangler": "^4.158.0",
    "y-protocols": "^1.0.7"
  },
  "patchedDependencies": {
    "@tiptap/y-tiptap@3.0.11": "patches/@tiptap%2Fy-tiptap@3.0.11.patch"
  }
}
